rules_version = '2';
// 익명 로그인한 사용자(학생·교사 페이지)만 읽고 쓸 수 있습니다.
// 기록은 수업 코드별로 classes/{수업코드}/ 아래에 저장됩니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /classes/{cls}/students/{sid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['name','num','status','since','lastSeen','awayCount','awayTotalMs','theme']);
      allow delete: if request.auth != null;
    }
    match /classes/{cls}/ink/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['sid','key','s','at'])
        && request.resource.data.s is string && request.resource.data.s.size() < 900000;
    }
    match /classes/{cls}/events/{eid} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['sid','name','num','type','at','durMs']);
    }
  }
}
